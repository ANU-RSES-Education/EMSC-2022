# Source Dockerfile — NOT read by Binder directly.
#
# Built by .github/workflows/build-binder-image.yml and pushed to
# ghcr.io/anu-rses-education/emsc-2022. Binder reads .binder/Dockerfile,
# which just does `FROM` on the published image.
#
# To modify the runtime env: edit this file (and optionally mirror the change
# in .binder/environment.yml for documentation), commit, push. CI rebuilds.

FROM quay.io/jupyter/scipy-notebook:python-3.11

LABEL org.opencontainers.image.source="https://github.com/ANU-RSES-Education/EMSC-2022"
LABEL org.opencontainers.image.description="EMSC 2022 course environment for Binder"
LABEL org.opencontainers.image.licenses="MIT"

USER root

# System packages — libglx-mesa0 covers the system GLX extension that the
# conda-provided Mesa hooks into. libgl1-mesa-dri is kept out (large, plus
# scipy-notebook's conda mesa is sufficient for headless rendering).
RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      libglx-mesa0 \
      curl \
      wget \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Quarto CLI
ARG QUARTO_VERSION=1.4.550
RUN curl -fsSL -o /tmp/quarto.deb \
      "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.deb" \
 && dpkg -i /tmp/quarto.deb \
 && rm /tmp/quarto.deb

USER ${NB_UID}

# Scientific conda deps on top of scipy-notebook's base (which already has
# numpy, scipy, pandas, sympy, matplotlib, h5py, pytest).
#
# Keep pyvista without `[all]` — the heavy extras (trame, trame-vtk,
# trame-vuetify, ipywidgets, imageio, meshio, scooby, nest-asyncio) are
# installed via pip below where appropriate.
RUN mamba install --yes -c conda-forge \
      "mpmath<=1.3" \
      mesalib \
      pyvista \
      obspy \
 && mamba clean --all -f -y

# Pip deps: jupyter/Quarto integration, VTK-on-web stack, gmsh, jupytext.
RUN pip install --no-cache-dir \
      gmsh \
      "jupyterlab>=4.1" \
      "jupytext>=1.16.1" \
      "pygments>=2.17.0" \
      trame-vtk \
      trame-vuetify \
      jupyter-server-proxy \
      "jupyterlab-quarto>=0.3.3" \
      trame_jupyter_extension

# code-server (VS Code in the browser). Installed to the user's home so
# Binder's jovyan user can launch it.
ARG CODE_SERVER_VERSION=4.16.1
RUN curl -fsSL -o /tmp/code-server.tar.gz \
      "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz" \
 && mkdir -p "${HOME}/.code-server" \
 && tar xzf /tmp/code-server.tar.gz --strip-components=1 -C "${HOME}/.code-server" \
 && rm /tmp/code-server.tar.gz \
 && mkdir -p "${HOME}/.local/bin" \
 && ln -sf "${HOME}/.code-server/bin/code-server" "${HOME}/.local/bin/code-server"

# Pre-install VS Code extensions so first launch on Binder is instant.
RUN "${HOME}/.code-server/bin/code-server" --install-extension ms-python.python \
 && "${HOME}/.code-server/bin/code-server" --install-extension sumneko.lua \
 && "${HOME}/.code-server/bin/code-server" --install-extension quarto.quarto
