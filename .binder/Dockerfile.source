# Source Dockerfile — NOT read by Binder directly.
#
# Built by .github/workflows/build-binder-image.yml and pushed to
# ghcr.io/anu-rses-education/emsc-2022. Binder reads .binder/Dockerfile,
# which just does `FROM` on the published image.
#
# To modify the runtime env: edit this file (and optionally mirror the change
# in .binder/environment.yml for documentation), commit, push. CI rebuilds.

FROM quay.io/jupyter/scipy-notebook:python-3.11

LABEL org.opencontainers.image.source="https://github.com/ANU-RSES-Education/EMSC-2022"
LABEL org.opencontainers.image.description="EMSC 2022 course environment for Binder"
LABEL org.opencontainers.image.licenses="MIT"

USER root

# libglx-mesa0 — the system GLX extension that the conda-provided Mesa hooks
# into for headless pyvista/VTK rendering.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends \
      libglx-mesa0 \
      curl \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Quarto CLI (command-line tool — cheap, no jupyter integration here).
ARG QUARTO_VERSION=1.4.550
RUN curl -fsSL -o /tmp/quarto.deb \
      "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.deb" \
 && dpkg -i /tmp/quarto.deb \
 && rm /tmp/quarto.deb

USER ${NB_UID}

# Scientific conda deps on top of scipy-notebook (which already has
# numpy, scipy, pandas, sympy, matplotlib, h5py, pytest, jupyterlab).
RUN mamba install --yes -c conda-forge \
      "mpmath<=1.3" \
      mesalib \
      pyvista \
      obspy \
 && mamba clean --all -f -y

# Pip deps. Deliberately minimal — nothing here registers a jupyter_server
# extension or a JupyterLab extension, so there is zero extra startup cost
# over plain scipy-notebook. If inline trame widgets are needed later,
# re-add trame_jupyter_extension + jupyter-server-proxy and budget the
# extra startup seconds.
RUN pip install --no-cache-dir \
      gmsh \
      "jupytext>=1.16.1" \
      trame-vtk \
      trame-vuetify

# Sanity-import of the heavy deps so a broken install fails CI rather than
# shipping a brown image to Binder.
RUN python -c "import numpy, scipy, pandas, obspy, pyvista, h5py, sympy; print('imports OK')"
